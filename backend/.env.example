# ==============================================================================
# SmartRent Backend - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Key (safe for client / RLS requests)
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Supabase Secret / Service Role Key (STRICT: internal background worker only)
SUPABASE_SECRET_KEY=your_supabase_secret_service_role_key

# Supabase JWT Validation (Choose either JWKS URL or JWT Secret)
# Option A (Recommended for production): JWKS URL from Supabase Auth
# e.g. https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Option B: Symmetric JWT Secret (legacy Supabase projects)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# MQTT Mosquitto Broker Configuration
# ------------------------------------------------------------------------------
# Hostname or IP of Mosquitto broker
MQTT_BROKER_HOST=localhost
# Port (8883 for TLS, 1883 for unencrypted local dev)
MQTT_BROKER_PORT=8883
# Enable TLS encryption for MQTT connection
MQTT_TLS_ENABLED=true

# Paths to TLS certificates (optional if using public trusted CA like Let's Encrypt)
# MQTT_CA_CERT_PATH=/path/to/ca.crt
# MQTT_CLIENT_CERT_PATH=/path/to/client.crt
# MQTT_CLIENT_KEY_PATH=/path/to/client.key

# Backend Worker Credentials (Superuser across all properties)
MQTT_WORKER_USERNAME=backend_worker
MQTT_WORKER_PASSWORD=your_secure_backend_worker_password
MQTT_KEEPALIVE=60

# ------------------------------------------------------------------------------
# Security & Smart Lock PIN Encryption
# ------------------------------------------------------------------------------
# 32-byte URL-safe base64-encoded key for AES/Fernet PIN encryption at rest
# Generate in Python: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PIN_ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
