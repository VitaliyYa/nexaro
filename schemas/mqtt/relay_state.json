{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartrent.io/schemas/mqtt/relay_state.json",
  "title": "RelayStatePayload",
  "description": "Reported physical state of a relay, switch, or power socket.",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": ["ON", "OFF"]
    },
    "power_w": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Current power consumption in Watts"
    },
    "voltage_v": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Line voltage in Volts"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of status update"
    }
  },
  "required": ["state", "timestamp"],
  "additionalProperties": false
}
