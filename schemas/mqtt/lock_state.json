{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartrent.io/schemas/mqtt/lock_state.json",
  "title": "LockStatePayload",
  "description": "Reported physical state of a smart lock (e.g. TTLock).",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": ["locked", "unlocked", "jammed", "unknown"],
      "description": "Current lock mechanical state"
    },
    "battery": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Battery level percentage"
    },
    "last_trigger": {
      "type": "string",
      "enum": ["manual", "passcode", "card", "fingerprint", "app", "auto_lock", "unknown"],
      "description": "Source or method of the last lock/unlock action"
    },
    "error": {
      "type": ["string", "null"],
      "description": "Diagnostic error message or null if normal"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of status update"
    }
  },
  "required": ["state", "battery", "timestamp"],
  "additionalProperties": false
}
